# Anthropic APIキー（https://console.anthropic.com/ で取得）
# このファイルをコピーして .env を作成し、実際の値を入れてください。
# .env は .gitignore 済みのためコミットされません。
ANTHROPIC_API_KEY=

# 省略可。既定値は claude-opus-4-8 です。コストを抑えたい場合は claude-sonnet-5 に変更できます。
# ANTHROPIC_MODEL=claude-opus-4-8

# Instagram投稿提案をGPTで比較する場合に使用。大会・スタンプ機能は引き続き
# Anthropic設定を使用する。省略時のInstagram用GPTモデルはgpt-5.6-terra。
OPENAI_API_KEY=
# OPENAI_INSTAGRAM_MODEL=gpt-5.6-terra
# 本番で安全確認が終わるまでは未設定（＝GPT停止）のままにする。
# OPENAI_INSTAGRAM_ENABLED=true

# Instagram AI機能用のDB接続文字列（Postgres）。
# tokyowaves-sns-agentプロジェクトと同じNeon DBを共有する運用のため、
# 同プロジェクトの .env.local にある値をそのままコピーして使う。
DATABASE_URL=

# 省略可。Instagram AI機能の概算コスト表示用の為替レート（円/ドル）。
# 省略時は150円で計算する。
# USD_JPY_RATE=150
